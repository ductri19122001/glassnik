### 0. Set JWT Token (replace after login)
@JWT = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImlhdCI6MTc3MzI4MzI4NCwiZXhwIjoxNzczMjg0MTg0fQ.3f6QtrOfcl6gmay9KmdYBTN9PlAVEApxohsLaHed70k

### 1. Register a new user
# send this request first to create a new user account. You can change the email and password if you want.

POST http://localhost:3000/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123",
  "username": "testuser"
}

### 2. Login with the new user
# after successful login, copy "access_token" from response and use for the next requests.

POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

### 3. Test Get Videos
# after successful login, replace {{JWT}} with the token from request 2

GET http://localhost:3000/videos
Authorization: Bearer {{JWT}}

### 4. Direct Upload Video
# Upload video and metadata in a request (multipart/form-data)

POST http://localhost:3000/videos/upload
Authorization: Bearer {{JWT}}
Content-Type: multipart/form-data; boundary=glassnikBoundary

--glassnikBoundary
Content-Disposition: form-data; name="title"

My TikTok Style Video
--glassnikBoundary
Content-Disposition: form-data; name="description"

This is a direct upload.
--glassnikBoundary
Content-Disposition: form-data; name="file"; filename="1111.mp4"
Content-Type: video/mp4

< C:\Users\duong\OneDrive - Western Sydney University\Documents\GitHub\glassnik\1111.mp4
--glassnikBoundary--

### 4b. Direct Upload Video (with discovery metadata + multiple categories/activities)
# Use this request if you want to test categoryIds/activityIds/place/author in one upload.

POST http://localhost:3000/videos/upload
Authorization: Bearer {{JWT}}
Content-Type: multipart/form-data; boundary=glassnikBoundary

--glassnikBoundary
Content-Disposition: form-data; name="title"

My TikTok Style Video - Metadata
--glassnikBoundary
Content-Disposition: form-data; name="description"

This is a direct upload with metadata.
--glassnikBoundary
Content-Disposition: form-data; name="categoryIds"

1
--glassnikBoundary
Content-Disposition: form-data; name="categoryIds"

2
--glassnikBoundary
Content-Disposition: form-data; name="activityIds"

1
--glassnikBoundary
Content-Disposition: form-data; name="activityIds"

2
--glassnikBoundary
Content-Disposition: form-data; name="placeId"

1
--glassnikBoundary
Content-Disposition: form-data; name="locationName"

Chatuchak Market
--glassnikBoundary
Content-Disposition: form-data; name="authorDisplayName"

Duong Tran
--glassnikBoundary
Content-Disposition: form-data; name="file"; filename="1111.mp4"
Content-Type: video/mp4

< C:\Users\duong\OneDrive - Western Sydney University\Documents\GitHub\glassnik\1111.mp4
--glassnikBoundary--

### 5. Delete Video
# Change :videoId with the ID video you want to delete (get the ID from request 3 or 4)

DELETE http://localhost:3000/videos/4
Authorization: Bearer {{JWT}}

### 6. Apply for Creator
# Apply to be a Creator

POST http://localhost:3000/applications
Authorization: Bearer {{JWT}}
Content-Type: application/json

{
  "capabilityCode": "live.creator",
  "notes": "I want to stream games"
}

### 7. Subscribe
# sign for Premium (simulator)

POST http://localhost:3000/subscriptions
Authorization: Bearer {{JWT}}
Content-Type: application/json

{
  "planCode": "premium"
}

### 8. Check Subscription
# check the current subscription status

GET http://localhost:3000/subscriptions/current
Authorization: Bearer {{JWT}}

### 9. Cancel Subscription
# cancel the current subscription

POST http://localhost:3000/subscriptions/cancel
Authorization: Bearer {{JWT}}

### 10. Discovery - Feed
# Filter by single category using categoryId (even though videos can have multiple categories).

GET http://localhost:3000/videos/feed?categoryId=1&limit=10
Authorization: Bearer {{JWT}}

### 11. Discovery - Explore
# Filter by single category using categoryId.

GET http://localhost:3000/videos/explore?categoryId=1&placeId=1&page=1&limit=10
Authorization: Bearer {{JWT}}

### 12. Discovery - Trending
# Filter by single category using categoryId.

GET http://localhost:3000/videos/trending?categoryId=2&limit=10
Authorization: Bearer {{JWT}}

### 13. Discovery - Nearby

GET http://localhost:3000/videos/nearby?lat=13.7995&lng=100.5501&radius=5&page=1&limit=10
Authorization: Bearer {{JWT}}

### 14. Videographer Profile

GET http://localhost:3000/videographers/4
Authorization: Bearer {{JWT}}

### 15. Videographer Videos

GET http://localhost:3000/videographers/1/videos?page=1&limit=10
Authorization: Bearer {{JWT}}

### 16. Seed Discovery Data (run in terminal)
# npm run db:seed

### 17. Moderation - Create report
# Requires a valid JWT. This can be a normal user token.
# Set @JWT at the top before running.
POST http://localhost:3000/moderation/reports
Authorization: Bearer {{JWT}}
Content-Type: application/json

{
  "videoId": 19,
  "reason": "NUDITY",
  "details": "Possible nudity in first 10 seconds"
}

### 18. Moderation - List queue
# Requires moderator/admin access via header (x-moderator: true or x-admin: true).
GET http://localhost:3000/moderation/queue?status=PENDING&minPriority=50
Authorization: Bearer {{JWT}}
x-moderator: true

### 19. Moderation - Assign queue item
# Assigns the queue item to the moderator user (or a specific user if provided).
PATCH http://localhost:3000/moderation/queue/1/assign
Authorization: Bearer {{JWT}}
x-moderator: true
Content-Type: application/json

{
  "assignedToId": 3
}

### 20. Moderation - Take action
# Creates a moderation action and updates video moderation status.
POST http://localhost:3000/moderation/actions
Authorization: Bearer {{JWT}}
x-moderator: true
Content-Type: application/json

{
  "videoId": 17,
  "action": "APPROVE",
  "reason": "Content OK",
  "policyVersion": "v1.0",
  "queueItemId": 1
}
